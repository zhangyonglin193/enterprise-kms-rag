# 复制为 .env.kms 后填写；不能复用评测数据库和目录。
QA_PORT=6341
KMS_PORT=6342
KMS_HOST=127.0.0.1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_kms_user
MYSQL_PASSWORD=your_kms_password
MYSQL_DATABASE=enterprise_kms
FAISS_INDEX_PATH=data/kms/faiss/index
UPLOAD_DIR=data/kms/uploads
DOCS_DIR=data/kms/docs
GW_AUDIT_DIR=data/kms/audit
GW_STATE_PATH=data/kms/gateway/state.sqlite3
# 企业模型网关必须经甲方批准，默认不允许发送问题或文档。
MODEL_API_BASE=https://approved-model.example/v1
MODEL_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
GW_MODEL_EGRESS_ALLOWED=0
GW_ENABLED=1
GW_RATE_LIMIT_PER_MINUTE=60
GW_ANSWER_MAX_CHARS=3000
KMS_DEMO_SEED=0
KMS_CORS_ORIGINS=
# 审计员兜底名单（逗号分隔工号）。HR 主数据未同步时使用；
# 正常路径由 HR 任职与安全职级判定，此处留空即可。
KMS_AUDITOR_EMPLOYEES=

# —— HR 系统 HTTP 接入（KMS 作为 Pull 方，只读拉取组织与员工）——
# 生产指向甲方 HR 系统；演示/联调用 scripts/mock_hr_service.py 起本地模拟源。
# 选用 hr_api 时必须配 KMS_HR_API_BASE，否则启动即失败。
# KMS_DIRECTORY_SOURCE 可选 seed / ldap / ad / hr_api。
KMS_DIRECTORY_SOURCE=seed
KMS_HR_API_BASE=
KMS_HR_API_TOKEN=
KMS_HR_API_TIMEOUT=10
KMS_TOKEN_EXPIRE_HOURS=1
# 空值时在受限数据目录自动生成；生产建议注入独立随机密钥。
KMS_SECRET_KEY=
UVICORN_WORKERS=1
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
# ===== 组织目录源（可插拔）：seed 内置种子 / ldap 标准目录 / ad 活动目录 =====
KMS_DIRECTORY_SOURCE=seed
KMS_LDAP_URI=
KMS_LDAP_BIND_DN=
# 只读绑定口令，仅在本机 .env.kms 填写，切勿入库。
KMS_LDAP_BIND_PASSWORD=
KMS_LDAP_BASE_DN=
KMS_LDAP_EMPLOYEE_FILTER=(objectClass=person)
KMS_LDAP_ORG_FILTER=(objectClass=organizationalUnit)
KMS_LDAP_EMPLOYEE_NO_ATTR=employeeNumber
KMS_LDAP_NAME_ATTR=cn
KMS_LDAP_DEPT_ATTR=department
KMS_LDAP_TITLE_ATTR=title
KMS_LDAP_LEVEL_ATTR=employeeType
KMS_LDAP_TIMEOUT=8
KMS_LDAP_SEED_JSON=
# ===== 统一登录 OIDC / OAuth2（可插拔）：builtin 内置模拟 IdP / external 外部 OI 平台 =====
KMS_OIDC_PROVIDER=builtin
KMS_OIDC_ISSUER=
KMS_OIDC_JWKS_URL=
KMS_OIDC_CLIENT_ID=kms-web
# 外部 OI 平台客户端密钥，仅在本机 .env.kms 填写，切勿入库。
KMS_OIDC_CLIENT_SECRET=
KMS_OIDC_REDIRECT_URI=
KMS_OIDC_EMPLOYEE_CLAIM=emp
# ===== 权限隔离定向推荐 =====
KMS_REC_ENABLED=1
KMS_REC_TOP_N=10
KMS_REC_WEIGHT_ORG=0.35
KMS_REC_WEIGHT_SEMANTIC=0.35
KMS_REC_WEIGHT_COLLAB=0.20
KMS_REC_WEIGHT_POPULAR=0.10
KMS_REC_COLLAB_MIN=3
KMS_REC_HALF_LIFE_DAYS=30
