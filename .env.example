# ==============================================================================
# 环境变量模板（复制为 .env 后填写真实值，严禁将此文件提交到代码仓库）
# 生产部署时 .env 已加入 .gitignore
# ==============================================================================

# ===== 模型服务 =====
# 按实际部署填写；仓库内不提供任何真实服务地址。
# MODEL_API_BASE 支持 OpenAI 兼容协议（/v1/chat/completions）。
MODEL_API_BASE=http://127.0.0.1:8289/v1
MODEL_API_KEY=sk-your-api-key-here
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
OCR_MODEL=PaddlePaddle/PaddleOCR-VL-1.5

# ===== MySQL（生产服务器填写赛方账号） =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=your_mysql_database

# ===== 服务端口 =====
QA_PORT=6341
KMS_PORT=6342
QA_HOST=0.0.0.0
KMS_HOST=127.0.0.1
KMS_DEMO_SEED=0
KMS_CORS_ORIGINS=
KMS_TOKEN_EXPIRE_HOURS=1
# 留空则启动时自动生成并落盘到 data/kms_secret.key（不得入库）
KMS_SECRET_KEY=

# ===== RAG 参数 =====
EMBEDDING_DIM=1024
CHUNK_SIZE=300
CHUNK_OVERLAP=80
TOP_K_RETRIEVE=20
TOP_K_RERANK=8
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3

# ===== 性能调优 =====
ENABLE_RERANK=1
EMBEDDING_BATCH_SIZE=32
MAX_CONTEXT_CHARS=3000
ENABLE_BM25=1
BM25_TOP_K=20
RRF_K=35

# ===== 缓存与查询改写 =====
ENABLE_CACHE=1
CACHE_MAX_SIZE=200
ENABLE_QUERY_REWRITE=1
QUERY_REWRITE_MAX_TOKENS=64

# ===== 并发 =====
THREAD_POOL_SIZE=100
UVICORN_WORKERS=1

# ===== 路径（相对项目根目录） =====
FAISS_INDEX_PATH=data/faiss/index
UPLOAD_DIR=data/uploads
DOCS_DIR=data/docs

# ===== 对外 API 网关（/gw/api/v1） =====
GW_ENABLED=1
GW_RATE_LIMIT_PER_MINUTE=60
GW_AUDIT_DIR=data/gw_audit
GW_ANSWER_MAX_CHARS=3000
GW_STATE_PATH=data/gateway/state.sqlite3
GW_MODEL_EGRESS_ALLOWED=0

# ===== 飞书机器人（开放平台-自建应用） =====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ===== 企业微信机器人（自建应用-接收消息服务器配置） =====
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
